# Copia este archivo a .env y ajusta lo que necesites.
# Todos los valores tienen defaults razonables si dejas la variable vacía o la omites.

# --- Detección de aplausos ---

# Cuántas veces por encima del piso de ruido calibrado debe estar el RMS de un
# bloque para considerarlo "fuerte". Súbelo si detecta ruidos normales como aplausos.
CLAP_AMPLITUDE_MULTIPLIER=3.0

# Piso mínimo de amplitud absoluto (evita falsos positivos en silencio total/micrófono muy sensible).
CLAP_MIN_AMPLITUDE_FLOOR=0.01

# Multiplicador de desvío estándar usado durante la calibración (media + k*std).
CLAP_NOISE_FLOOR_STD_K=1.5

# Frecuencia de corte (Hz) para el gate espectral: un aplauso debe tener energía
# significativa por encima de este valor. Debe ser menor a sample_rate/2 (22050 por defecto).
CLAP_HIGH_FREQ_CUTOFF_HZ=2000

# Proporción mínima de energía total que debe estar por encima del corte de frecuencia.
CLAP_MIN_HIGH_FREQ_RATIO=0.35

# Cuánto más fuerte debe ser el bloque candidato respecto a la línea base reciente.
CLAP_ATTACK_RATIO=2.5

# Tiempo mínimo entre dos disparos consecutivos.
CLAP_COOLDOWN_SECONDS=1.5

# Segundos de "silencio de detección" tras disparar una acción (evita que el propio
# sonido de Spotify abriéndose/reproduciendo se detecte como un nuevo aplauso).
CLAP_POST_TRIGGER_MUTE_SECONDS=5.0

# Segundos de calibración de ruido ambiente al iniciar.
CLAP_CALIBRATION_SECONDS=2.0

# Si está en true (recomendado en lugares con ruido de fondo), exige DOS
# golpes tipo-aplauso seguidos antes de disparar la acción (como los
# aparatos "clap on/clap off"). Ponelo en false si preferís que reaccione
# con un solo aplauso (solo recomendable en ambientes silenciosos).
CLAP_REQUIRE_DOUBLE_CLAP=true

# Separación mínima y máxima (en segundos) entre los dos golpes para que
# cuenten como un "doble aplauso" válido.
CLAP_DOUBLE_CLAP_MIN_GAP_SECONDS=0.15
CLAP_DOUBLE_CLAP_MAX_GAP_SECONDS=0.7

# --- Spotify ---

# Texto de búsqueda usado como fallback si no hay URI ni credenciales configuradas.
SPOTIFY_TRACK_QUERY="The Clash Should I Stay or Should I Go"

# URI exacto de la canción en Spotify (RECOMENDADO). Para obtenerlo: abre la canción
# en la app de Spotify > botón "..." > Compartir > Copiar URI de Spotify.
# Si lo dejas vacío se usa un URI por defecto embebido en el código, que fue
# encontrado por búsqueda pública y NO está garantizado al 100% - revisa el README.
SPOTIFY_TRACK_URI=

# Credenciales opcionales de una app en https://developer.spotify.com/dashboard
# (Client Credentials flow). Solo se usan para BUSCAR y resolver el URI automáticamente
# si no configuraste SPOTIFY_TRACK_URI; nunca se usan para reproducir música.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Asistente de voz (saludo del primer aplauso del día) ---

# Poné esto en false para desactivar el saludo por completo (los aplausos
# van a seguir controlando la música normalmente).
ASSISTANT_ENABLED=true

# Tu ciudad, para el clima. Ejemplo: "Buenos Aires,AR" (agregar el código
# de país con una coma ayuda a que encuentre la ciudad correcta).
WEATHER_CITY=

# Clave gratuita de OpenWeatherMap (https://home.openweathermap.org/users/sign_up).
# Después de crear la cuenta, andá a "API keys" y copiá la que te dan ahí.
# Importante: las claves nuevas pueden tardar hasta 2 horas en activarse;
# si el clima no aparece al principio, esperá un rato y probá de nuevo.
WEATHER_API_KEY=

# Si la temperatura está por debajo de este valor (en grados Celsius), el
# asistente te sugiere abrigarte.
ASSISTANT_COLD_THRESHOLD_C=12.0

# Dónde vive tu lista de tareas pendientes (una tarea por línea) y el
# archivo interno que recuerda si ya te saludó hoy. Por defecto usan una
# carpeta fuera del proyecto (%APPDATA%\ClapSpotify en Windows) para que
# sobrevivan aunque vuelvas a descargar el proyecto de GitHub.
TASKS_FILE=
ASSISTANT_STATE_FILE=

# Cuántas tareas como máximo lee en voz alta (para no hacer un discurso eterno).
ASSISTANT_MAX_TASKS=5

# A qué volumen (0-100) baja Spotify mientras habla el asistente.
ASSISTANT_DUCK_VOLUME_PERCENT=15

# Si querés que te salude por tu nombre/título, ej: "Mateo". Dejalo vacío
# para un saludo genérico ("Bienvenido a casa.").
ASSISTANT_GREETING_TITLE=

# Velocidad de la voz (palabras por minuto aprox). Default de pyttsx3 ~200.
ASSISTANT_SPEECH_RATE=175
